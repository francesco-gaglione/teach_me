# Copy to .env (`cp .env.example .env`), fill in the values and `chmod 600 .env`.
# .env is git-ignored. Never commit real values.

# REQUIRED. Key that encrypts the users' LLM keys in the database: 32 random
# bytes in base64. Generate it ONCE with:
#   openssl rand -base64 32
# Keep a copy outside the database backups (a lost key makes the stored LLM
# keys unreadable: every user would have to enter theirs again). Do not change
# it after the first start.
TEACH_ME_SECRET_KEY=

# Only for the upgrade from the single-user version: this key becomes the key
# of the user `owner` at the first start, if `owner` has none. It is read only
# with default_provider = "openrouter"; with "anthropic" (the current
# teach_me.toml) the variable is TEACH_ME_ANTHROPIC_API_KEY. Afterwards each user saves their own from the app
# and this line can be removed. The provider itself is selected in teach_me.toml.
TEACH_ME_OPENROUTER_API_KEY=

# No longer used (sign-in is user name + password): if still set it is ignored,
# with a warning in the log. Remove it.
# TEACH_ME_API_TOKEN=

# Address the port is published on: the Tailscale IPv4 of this host (`tailscale ip -4`).
BIND_IP=

# Optional: LAN IPv4 of this host (e.g. 192.168.1.50), to reach the backend from
# the home network without Tailscale. On the LAN the traffic is plain HTTP:
# passwords and session tokens are readable by anyone on that network. Leave it
# unset to publish on Tailscale only (the port is then also bound on 127.0.0.1).
# LAN_BIND_IP=
# Required to confirm a LAN_BIND_IP that is not a loopback address: deploy.sh refuses to
# deploy without it. Set it to 1 only if you accept plain HTTP on your home network.
# ALLOW_PLAIN_LAN=1

# Optional: memory limit of the backend container (default 2g).
# TEACH_ME_MEM_LIMIT=2g

# Optional: host port (default 8080)
# TEACH_ME_PORT=8080

# Read lessons aloud (ADR 0013). Without TEACH_ME_TTS_URL the feature is off and the app
# hides the listening controls. The other variables only matter when it is on.
# URL of the speech engine service (Qwen3-TTS HTTP server, the `tts` service of
# docker-compose.yml, reachable only from the backend). Compose defaults it to
# http://tts:8080: leave it commented to keep the feature on, or set it EMPTY
# (`TEACH_ME_TTS_URL=`) to switch it off. The first start of `tts` downloads
# about 4.5 GB; listening works once `docker ps` shows teach-me-tts as healthy.
# TEACH_ME_TTS_URL=http://tts:8080
# Voices offered in Settings, in this order, as `id:Label` (ids are what the
# engine calls them; the app never sees anything but id and label).
# TEACH_ME_TTS_VOICES=vivian:Vivian,serena:Serena,ryan:Ryan,aiden:Aiden,eric:Eric,dylan:Dylan
# Voice of users who have not chosen one; must be in TEACH_ME_TTS_VOICES.
# TEACH_ME_TTS_DEFAULT_VOICE=vivian
# Model name, only part of the clip cache key: change it when the model changes
# so old clips are not reused.
# TEACH_ME_TTS_MODEL=1.7b-customvoice
# Where the clips are kept: the volume teach_me_audio, a rebuildable cache that
# backup.sh leaves out. Do not change it (the compose volume is mounted at /audio).
# TEACH_ME_AUDIO_DIR=/audio

# Resource limits (all optional; defaults shown). They are read from the
# environment only, see docs/contracts/api-conventions.md section 12.
# Bytes of uploaded documents per user; 0 = unlimited.
# TEACH_ME_USER_STORAGE_QUOTA_BYTES=1073741824
# Input + output LLM tokens per user per UTC day; 0 = no daily budget.
# TEACH_ME_USER_DAILY_LLM_TOKENS=0
# Concurrent SSE streams per user.
# TEACH_ME_MAX_SSE_PER_USER=8
# Jobs running at once on the whole server, and the time budget of one job.
# TEACH_ME_JOB_MAX_CONCURRENT=2
# TEACH_ME_JOB_TIMEOUT_SECS=900
