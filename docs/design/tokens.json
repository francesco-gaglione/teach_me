      "body": {
        "fontFamily": "reading",
        "fontWeight": 400,
        "fontSize": 17,
        "lineHeight": 28,
        "letterSpacing": 0
      },
      "bodyStrong": {
        "fontFamily": "reading",
        "fontWeight": 600,
        "fontSize": 17,
