  "spacing": {
    "none": 0,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64
  },
  "layout": {
    "screenMarginCompact": 16,
    "screenMarginMedium": 24,
    "readingMaxWidth": 600,
    "contentMaxWidth": 840,
    "minTouchTarget": 48,
    "iconSize": 24,
    "iconSizeSmall": 20,
    "iconStroke": 1.75,
    "blockGap": 24,
    "blockGapTight": 12,
    "topBarHeight": 56,
    "controlHeight": 48,
    "controlHeightLarge": 56,
    "compactMaxWidth": 600,
    "mediumMaxWidth": 840,
    "screenMarginExpanded": 32,
    "listPaneWidth": 360,
    "paneHeaderHeight": 72,
    "dialogWidth": 360,
    "dialogWidthWide": 480,
    "contextPaneWidth": 280,
    "contextPaneBreakpoint": 1100,
    "contextPaneGap": 32,
    "choiceMinHeight": 56,
    "blankFieldWidth": 120,
    "blankFieldHeight": 40,
    "codeCollapsedLines": 16
  },
  "shape": {
    "none": 0,
    "sm": 6,
    "md": 10,
    "lg": 16,
    "full": 9999
  },
  "stroke": {
    "hairline": 1,
    "control": 1.5,
    "selected": 2,
    "focus": 3,
    "focusOffset": 2
  },
  "elevation": {
    "flat": {
      "y": 0,
      "blur": 0,
      "alpha": 0
    },
    "raised": {
      "y": 4,
      "blur": 16,
      "alphaLight": 0.12,
      "alphaDark": 0.5,
      "color": "#000000"
    },
    "overlay": {
      "y": 8,
      "blur": 32,
      "alphaLight": 0.18,
      "alphaDark": 0.6,
      "color": "#000000"
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 100,
      "base": 200,
      "slow": 300,
      "slower": 400
    },
    "easing": {
      "out": [
        0,
        0,
        0.2,
        1
      ],
      "inOut": [
        0.4,
        0,
        0.2,
        1
      ],
      "in_": [
        0.4,
        0,
        1,
        1
      ],
      "linear": [
        0,
        0,
        1,
        1
      ]
    },
    "semantic": {
      "press": {
        "duration": 100,
        "easing": "out"
      },
      "feedbackAppear": {
        "duration": 200,
        "easing": "out"
      },
      "selectionChange": {
        "duration": 100,
        "easing": "out"
      },
      "sectionReveal": {
        "duration": 300,
        "easing": "out"
      },
      "screenEnter": {
        "duration": 300,
        "easing": "out"
      },
      "screenExit": {
        "duration": 200,
        "easing": "in_"
      },
      "cardReveal": {
        "duration": 150,
        "easing": "inOut"
      },
      "progress": {
        "duration": 300,
        "easing": "inOut"
      },
      "unlock": {
        "duration": 200,
        "easing": "out"
      }
    },
    "reducedMotion": {
      "detect": "Settings.Global.ANIMATOR_DURATION_SCALE == 0f",
      "durationScale": 0,
      "replacement": "Nessuno spostamento/scala/scorrimento animato; solo cambio istantaneo o dissolvenza <= 100 ms. Il feedback resta visibile (icona + testo)."
    }
  },
  "highlight": {
    "note": "Evidenziatore con la penna (components/highlight.md). Misure in dp, tempi in ms.",
    "boxInsetY": 2,
    "boxInsetX": 2,
    "cornerRadius": 4,
    "lineWidth": 2,
    "gapBetweenColors": 1,
    "previewAlpha": 0.6,
    "eraseGhostAlpha": 0.35,
    "tapSlop": 8,
    "tapMaxDuration": 400,
    "lineBandTolerance": 4,
    "popoverGap": 8,
    "popoverButtonMinWidth": 96,
    "popoverFocusStroke": 2,
    "palette": {
      "height": 56,
      "swatch": 36,
      "swatchTarget": 48,
      "margin": 16,
      "paddingX": 4,
      "checkIcon": 20,
      "swatchBorder": 2,
      "idleHideMs": 6000,
      "toastLift": 72
    },
    "syncDebounceMs": 1500,
    "syncRetryMs": [
      5000,
      15000,
      60000
    ],
    "syncIndicatorAfterMs": 30000,
    "colors": [
      "yellow",
      "green",
      "blue",
      "pink"
    ],
    "defaultColor": "yellow"
  },
  "handwriting": {
    "note": "Scrittura a mano (components/handwriting.md, ADR 0015). Misure in dp, tempi in ms. I colori stanno in color.*.pen*; il colore salvato nel tratto e' il ruolo (ink|blue|red|green), non l'hex.",
    "tools": [
      "highlighter",
      "pen"
    ],
    "defaultTool": "highlighter",
    "inkColors": [
      "ink",
      "blue",
      "red",
      "green"
    ],
    "inkColorToken": {
      "ink": "penInk",
      "blue": "penBlue",
      "red": "penRed",
      "green": "penGreen"
    },
    "defaultInkColor": "ink",
    "widths": {
      "thin": 1.5,
      "medium": 2.5,
      "thick": 4
    },
    "defaultWidth": "medium",
    "usePressure": false,
    "strokeCap": "round",
    "strokeJoin": "round",
    "eraserRadius": 12,
    "eraserGhostAlpha": 0.35,
    "simplifyEpsilon": 0.4,
    "coordScale": 10000,
    "appSplitStrokeAtPoints": 800,
    "undoDepth": 50,
    "palette": {
      "toolButton": 48,
      "toolIcon": 24,
      "separatorWidth": 1,
      "separatorGap": 4,
      "widthSampleLength": 24,
      "widthSwatch": 36,
      "undoRedoButton": 48,
      "collapsedBelowWindowWidth": 660,
      "popoverGap": 8,
      "selectedBarHeight": 3,
      "selectedBarWidth": 20
    },
    "syncDebounceMs": 4000,
    "limits": {
      "maxStrokes": 2000,
      "maxPointsPerStroke": 1000,
      "maxPointsPerLesson": 200000,
      "x": {
        "min": -4,
        "max": 5
      },
      "y": {
        "min": -4,
        "max": 20
      },
      "maxBodyBytes": 4194304
    },
    "keys": {
      "undo": "Ctrl+Z",
      "redo": [
        "Ctrl+Shift+Z",
        "Ctrl+Y"
      ]
    }
  }
}
