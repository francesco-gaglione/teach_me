  "colorMeta": {
    "overlayOpacity": 0.4,
    "disabledContentOpacity": 1.0,
    "note": "disabledInk/disabledFill sono colori pieni, non opacità."
  },
  "typography": {
    "fontFamilies": {
      "ui": {
        "name": "Inter",
        "fallback": "sans-serif",
        "source": "Google Fonts (OFL), variabile, in res/font"
      },
      "reading": {
        "name": "Literata",
        "fallback": "serif",
        "source": "Google Fonts (OFL), variabile, in res/font"
      },
      "code": {
        "name": "JetBrains Mono",
        "fallback": "monospace",
        "source": "Google Fonts (OFL), variabile, in res/font"
      }
    },
    "ui": {
      "display": {
        "fontFamily": "ui",
        "fontWeight": 600,
        "fontSize": 32,
        "lineHeight": 40,
        "letterSpacing": 0
      },
      "title1": {
        "fontFamily": "ui",
        "fontWeight": 700,
        "fontSize": 26,
        "lineHeight": 34,
        "letterSpacing": -0.1
      },
      "title2": {
        "fontFamily": "ui",
        "fontWeight": 600,
        "fontSize": 21,
        "lineHeight": 28,
        "letterSpacing": 0
      },
      "title3": {
        "fontFamily": "ui",
        "fontWeight": 600,
        "fontSize": 18,
        "lineHeight": 26,
        "letterSpacing": 0
      },
      "bodyL": {
        "fontFamily": "ui",
        "fontWeight": 400,
        "fontSize": 16,
        "lineHeight": 24,
        "letterSpacing": 0.1
      },
      "body": {
        "fontFamily": "ui",
        "fontWeight": 400,
        "fontSize": 14,
        "lineHeight": 20,
        "letterSpacing": 0.2
      },
      "bodyS": {
        "fontFamily": "ui",
        "fontWeight": 400,
        "fontSize": 12,
        "lineHeight": 16,
        "letterSpacing": 0.3
      },
      "labelL": {
        "fontFamily": "ui",
        "fontWeight": 700,
        "fontSize": 16,
        "lineHeight": 24,
        "letterSpacing": 0.1
      },
      "label": {
        "fontFamily": "ui",
        "fontWeight": 600,
        "fontSize": 14,
        "lineHeight": 20,
        "letterSpacing": 0.1
      },
      "labelS": {
        "fontFamily": "ui",
        "fontWeight": 600,
        "fontSize": 12,
        "lineHeight": 16,
        "letterSpacing": 0.3
      }
    },
